# Root-level reference only — read by scripts/seed-users.mjs when you run
# `npm run seed` from the repo root against a REAL Supabase project.
#
# Next.js itself does NOT read this file: each app loads its own
# .env.local from its own directory (see apps/website/.env.example and
# apps/portal/.env.example) because NEXT_PUBLIC_* values are baked in
# per-app at build time. Copy this file's values into both app-level
# .env.local files, not just this one.

NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY
