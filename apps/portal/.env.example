# ---- Cross-app URLs (both apps need both values) ----
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001

# ---- Supabase (public: safe to expose to the browser) ----
# Leave unset to run in Demo Mode (in-memory/file-backed sample data, no
# Supabase project required). Set both to switch this app to a real backend.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----
# Used by Owner > Users > Create user, and scripts/seed-users.mjs.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Reserved for future AI features — the current Owner AI Assistant
# (src/app/(app)/owner/ai/actions.ts) is deliberately hardcoded to canned,
# templated responses regardless of this value; it is not read anywhere in
# the codebase today, so setting it has no effect yet. Never expose an
# Anthropic key to the browser once this IS wired up — server routes only.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY

# Optional: override where Demo Mode's shared data file lives. Defaults to
# <repo-root>/.demo-data/store.json, which is already correct for the
# apps/website + apps/portal layout — only set this if you moved the apps.
# DEMO_DATA_DIR=../../.demo-data
